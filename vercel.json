{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/_astro/(.*)", "destination": "/public/_astro/$1" },
    { "source": "/fonts/(.*)", "destination": "/public/fonts/$1" },
    { "source": "/images/(.*)", "destination": "/public/images/$1" },
    { "source": "/videos/(.*)", "destination": "/public/videos/$1" },
    { "source": "/uploads/(.*)", "destination": "/public/uploads/$1" },
    { "source": "/app.js", "destination": "/public/app.js" },
    { "source": "/cms-client.js", "destination": "/public/cms-client.js" },
    { "source": "/admin/login", "destination": "/public/admin/login.html" },
    { "source": "/admin", "destination": "/public/admin/index.html" },
    { "source": "/admin/(.*)", "destination": "/public/admin/index.html" },
    { "source": "/programs", "destination": "/programs.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/donations", "destination": "/donations.html" },
    { "source": "/teachers", "destination": "/teachers.html" },
    { "source": "/primary-school", "destination": "/primary-school.html" },
    { "source": "/middle-school", "destination": "/middle-school.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/admissions", "destination": "/admissions.html" },
    { "source": "/tuition", "destination": "/tuition.html" },
    { "source": "/open-house", "destination": "/open-house.html" },
    { "source": "/api/admin/login", "destination": "/api/admin/login.js" },
    { "source": "/api/admin/logout", "destination": "/api/admin/logout.js" },
    { "source": "/api/admin/check-auth", "destination": "/api/admin/check-auth.js" },
    { "source": "/api/admin/change-password", "destination": "/api/admin/change-password.js" },
    { "source": "/api/cms-data", "destination": "/api/cms-data.js" },
    { "source": "/api/cms/reset", "destination": "/api/cms/reset.js" },
    { "source": "/api/assets/list", "destination": "/api/assets/list.js" },
    { "source": "/api/assets/upload", "destination": "/api/assets/upload.js" },
    { "source": "/api/assets/replace", "destination": "/api/assets/replace.js" },
    { "source": "/api/(.*)", "destination": "/api/[...all].js" }
  ]
}
